2026-06-23 04:57:00 | sys_operation | sess_19ef29e3419_9b0a53 | INFO | {"event_id": "50dcaa6e-9dd7-486b-84e9-81b5bd9a1b16", "event_type": "sys_operation_end", "log_level": "INFO", "timestamp": "2026-06-23T04:57:00.474554+01:00", "module_type": "sys_operation", "module_id": "sys_operation", "module_name": "sys_operation", "status": "success", "message": "End to read file", "metadata": {}, "operation_name": "fs", "operation_mode": "local", "operation_desc": "local fs operation", "method_name": "read_file", "method_params": {"path": "/home/cz776/mate_home/.jiuwenswarm/config/config.yaml", "mode": "text", "encoding": "utf-8", "chunk_size": 0, "only_read": false, "method_name": "read_file"}, "method_result": {"code": 0, "message": "success", "data": {"path": "/home/cz776/mate_home/.jiuwenswarm/config/config.yaml", "content": "# 前端显示语言：zh（中文）/ en（英文），与 Web 界面语言切换同步\npreferred_language: zh\n\n# 日志目录：~/.jiuwenswarm/agent/.logs/\n# gateway.log / channel.log / agent_server.log 按源码路径分流；full.log 为汇总。\n# level：未单独指定时的默认级别。console_level：控制台；可省略则用 level。\n# 环境变量 LOG_LEVEL 仅覆盖控制台级别（不覆盖各日志文件）。\nlogging:\n  level: INFO\n  console_level: INFO\n  gateway: INFO\n  channel: INFO\n  agent_server: INFO\n  full: INFO\n\nmemory:\n  # ============================================================\n  # 记忆系统配置\n  # ============================================================\n  # 两个正交开关：\n  #   1) engine — 挂载哪套 rail（内置 / 外接 / 都挂 / 都不挂）\n  #   2) mode   — 内置记忆的存储位置（local | cloud），不影响外接\n  #\n  # 外接 rail 的启用 = (engine ∈ {external, both}) AND (external.provider 非空)\n  # 内置 rail 的启用 = (engine ∈ {builtin, both})  AND (mode=local)\n  #                    AND modes.agent.<当前 mode>.memory.enabled=true\n  # ============================================================\n\n  mode: ${MEMORY_MODE:-local}            # 内置记忆存储位置：local | cloud\n  # 记忆引擎总开关：builtin | external | both | none\n  #   builtin  — 仅内置记忆（默认，兼容旧配置）\n  #   external — 仅外接记忆（LTM / Mem0 / OpenViking / 插件）\n  #   both     — 内置 + 外接并存\n  #   none     — 全部关闭\n  engine: ${MEMORY_ENGINE:-builtin}\n  forbidden_memory_definition:\n    enabled: false\n    patterns: []\n    description:\n      zh: \"以下内容禁止记忆：密码、API密钥、Secret、Token、信用卡号、身份证号、手机号等敏感信息\"\n      en: \"The following content is forbidden to remember: passwords, API keys, secrets, tokens, credit card numbers, ID numbers, phone numbers and other sensitive information\"\n\n  # ------------------------------------------------------------\n  # 外接记忆（External Memory）\n  # ------------------------------------------------------------\n  # 启用方式（任选一种）：\n  #\n  # 【方案 1：YAML 直接改】\n  #   memory.engine: external   # 或 both\n  #   memory.external.provider: mem0   # 选一个：openjiuwen | mem0 | openviking\n  #   # 然后在下方对应的 mem0/openjiuwen/openviking 子段填 api_key 或 endpoint\n  #\n  # 【方案 2：环境变量覆盖】\n  #   export MEMORY_ENGINE=external\n  #   export MEMORY_EXTERNAL_PROVIDER=mem0\n  #   export MEM0_API_KEY=sk-xxx\n  #\n  # 【关闭外接记忆】\n  #   把 memory.engine 改回 builtin 或 none；\n  #   或把 memory.external.provider 留空（两者任一生效即可禁用）\n  #\n  # 【挂载模式常见组合】\n  #   ┌─────────────┬───────────────┬──────────────────────────────────────┐\n  #   │ engine      │ provider      │ 效果                                 │\n  #   ├─────────────┼───────────────┼──────────────────────────────────────┤\n  #   │ builtin     │ *             │ 只挂内置（默认；外接即使填了也不挂） │\n  #   │ external    │ openjiuwen    │ 只挂外接 LTM                         │\n  #   │ external    │ mem0          │ 只挂外接 Mem0                        │\n  #   │ external    │ openviking    │ 只挂外接 OpenViking                  │\n  #   │ external    │ <plugin-name> │ 只挂用户安装的插件                   │\n  #   │ both        │ 任一          │ 内置 + 外接同时挂（LLM 两套工具并列）│\n  #   │ none        │ *             │ 全关，任何记忆 rail 都不挂           │\n  #   └─────────────┴───────────────┴──────────────────────────────────────┘\n  #\n  # 说明：\n  # - 外接记忆 mode-independent：配置一次，plan / fast 模式全程生效，\n  #   跨 config 热重载持久存活（保留 prefetch 缓存、电路断路器、会话状态）\n  # - 单 provider 策略：同一时刻 provider 只能选一个\n  # - 失败降级：provider 构建失败或网络异常不阻塞主流程\n  external:\n    # 选哪家 provider。空字符串 = 禁用外接（等价于 engine=builtin）\n    provider: ${MEMORY_EXTERNAL_PROVIDER:-}   # '' | openjiuwen | mem0 | openviking | <plugin-name>\n    # 数据隔离标识（所有 provider 共用）\n    user_id: ${MEMORY_USER_ID:-__default__}\n    scope_id: ${MEMORY_SCOPE_ID:-__default__}\n\n    # -- OpenJiuwen LTM（本地长期记忆：KV + 向量 + DB）--\n    # 生效条件：provider='openjiuwen'\n    # 依赖顶层 embed 段提供 embedding 配置（不单独配置 api_key）\n    openjiuwen:\n      kv_type: shelve                                    # shelve | in_memory | sqlite\n      kv_path: ${MEMORY_KV_PATH:-}                       # 默认 ~/.jiuwenswarm/memory/ltm/kv\n      vector_type: chroma                                # chroma\n      vector_persist_dir: ${MEMORY_VECTOR_DIR:-}         # 默认 ~/.jiuwenswarm/memory/ltm/chroma\n      db_type: sqlite\n      db_path: ${MEMORY_DB_PATH:-}                       # 默认 ~/.jiuwenswarm/memory/ltm/ltm.db\n\n    # -- Mem0（云端事实抽取+语义检索）--\n    # 生效条件：provider='mem0'\n    # 必填：api_key（从 mem0.ai 获取）\n    mem0:\n      api_key: ${MEM0_API_KEY:-}\n      user_id: ${MEM0_USER_ID:-jiuwenswarm-user}\n      agent_id: ${MEM0_AGENT_ID:-jiuwenswarm}\n      rerank: true                                       # 搜索结果重排序（更准但更慢）\n\n    # -- OpenViking（字节上下文数据库）--\n    # 生效条件：provider='openviking'\n    # 必填：endpoint 可访问\n    openviking:\n      endpoint: ${OPENVIKING_ENDPOINT:-http://127.0.0.1:1933}\n      api_key: ${OPENVIKING_API_KEY:-}\n      account: ${OPENVIKING_ACCOUNT:-root}\n      user: ${OPENVIKING_USER:-default}\n\nmodels:\n  default:\n    model_client_config:\n      api_base: ${API_BASE}\n      api_key: ${API_KEY}\n      model_name: ${MODEL_NAME:-xiaomi/mimo-v2-omni}\n      client_provider: ${MODEL_PROVIDER}\n      timeout: 1800\n      verify_ssl: false\n      custom_headers: {}\n    model_config_obj:\n      temperature: 0.95\n  video:\n    model_client_config:\n      api_base: ${VIDEO_API_BASE}\n      api_key: ${VIDEO_API_KEY}\n      model_name: ${VIDEO_MODEL_NAME:-xiaomi/mimo-v2-omni}\n      client_provider: ${VIDEO_PROVIDER}\n      timeout: 1800\n      verify_ssl: false\n    model_config_obj:\n      temperature: 0.95\n  audio:\n    model_client_config:\n      api_base: ${AUDIO_API_BASE}\n      api_key: ${AUDIO_API_KEY}\n      model_name: ${AUDIO_MODEL_NAME:-openai/gpt-4o-audio-preview}\n      client_provider: ${AUDIO_PROVIDER}\n      verify_ssl: false\n      timeout: 1800\n    model_config_obj:\n      temperature: 0.95\n  vision:\n    model_client_config:\n      api_base: ${VISION_API_BASE}\n      api_key: ${VISION_API_KEY}\n      model_name: ${VISION_MODEL_NAME:-bytedance-seed/seed-2.0-mini}\n      client_provider: ${VISION_PROVIDER}\n      verify_ssl: false\n      timeout: 1800\n    model_config_obj:\n      temperature: 0.95\n  image_gen:\n    model_client_config:\n      api_base: ${IMAGE_GEN_API_BASE:-https://dashscope.aliyuncs.com/api/v1}\n      api_key: ${IMAGE_GEN_API_KEY}\n      model_name: ${IMAGE_GEN_MODEL_NAME:-qwen-image-max}\n      client_provider: ${IMAGE_GEN_PROVIDER:-DashScope}\n      verify_ssl: false\n      timeout: 1800\n    model_config_obj:\n      temperature: 0.95\n\ntelemetry:\n  enabled: false                    # 总开关（环境变量 OTEL_ENABLED 优先）\n  exporter: otlp                    # otlp / console / none\n  endpoint: http://localhost:4317   # OTLP endpoint\n  protocol: grpc                    # grpc / http\n  headers: {}                       # 公共 OTLP headers，可被 traces/metrics 覆盖\n  log_messages: true                # 是否在 span event 中记录完整消息内容\n  service_name: jiuwenswarm\n  provider_factory:                 # 自定义 provider factory，格式：module:function\n  traces:\n    exporter:                       # trace exporter，默认回退到 telemetry.exporter\n    endpoint:                       # trace endpoint，默认回退到 telemetry.endpoint\n    protocol:                       # trace protocol，默认回退到 telemetry.protocol\n    headers: {}                     # trace headers，默认回退到 telemetry.headers\n  metrics:\n    exporter:                       # metrics exporter，默认回退到 telemetry.exporter\n    endpoint:                       # metrics endpoint，默认回退到 telemetry.endpoint\n    protocol:                       # metrics protocol，默认回退到 telemetry.protocol\n    headers: {}                     # metrics headers，默认回退到 telemetry.headers\n\nreact:\n  agent_name: main_agent\n  max_iterations: 100\n  model_name: ${MODEL_NAME:-deepseek-chat}\n  skill_mode: all\n  # code_agent / research_agent 默认不启用；只有显式配置 enabled: true 才会显示并可被 task_tool 调用\n  # browser_agent 保持原行为，仍由浏览器 runtime 开关决定是否默认注册；这里只支持覆盖其参数\n  subagents:\n    code_agent:\n      enabled: false\n      # max_iterations: 15\n    research_agent:\n      enabled: false\n      # max_iterations: 15\n  answer_chunk_size: 500\n  stream_chunk_threshold: 50\n  stream_character_threshold: 2000\n  context_engine_config:\n    enable_kv_cache_release: false\n    enable_reload: true\n    enabled: true\n    message_summary_offloader_config:\n      messages_threshold:\n      tokens_threshold: 60000\n      large_message_threshold: 60000\n      offload_message_type: [\"tool\"]\n      protected_tool_names: [\"read_file:*SKILL.md\", \"reload_original_context_messages\"]\n      messages_to_keep:\n      keep_last_round: false\n      customized_summary_prompt:\n      enable_adaptive_compression: true\n      summary_max_tokens: 900\n      enable_precise_step: false\n      step_summary_max_context_messages: 8\n      content_max_chars_for_compression: 200000\n    dialogue_compressor_config:\n      messages_threshold:\n      tokens_threshold: 100000\n      messages_to_keep: 10\n      keep_last_round: false\n      compression_target_tokens: 1800\n      offload_writeback_enabled: false\n    current_round_compressor_config:\n      tokens_threshold: 100000\n      messages_to_keep: 3\n      min_selected_tokens_for_compression: 20000\n      compression_target_tokens: 4000\n      summary_merge_target_tokens: 4000\n      accumulated_summary_token_limit: 20000\n      summary_merge_min_blocks: 3\n      prior_context_window_size: 10\n      offload_writeback_enabled: false\n    round_level_compressor_config:\n      rounds_threshold: 2\n      tokens_threshold: 230000\n      trigger_total_tokens: 230000\n      target_total_tokens: 160000\n      compression_call_max_tokens: 250000\n      keep_last_round: true\n      keep_recent_messages: 6\n      messages_to_keep: 6\n      first_pass_target_tokens: 30000\n      second_pass_target_tokens: 20000\n      third_pass_target_tokens: 10000\n      truncate_head_ratio: 0.2\n      offload_writeback_enabled: false\n  # Skills 在线自演进配置\n  evolution:\n    enabled: true             # true = 启用在线 Skills 自演进\n    auto_scan: false           # true = 每轮对话后自动扫描（建议先用手动 /evolve）\n    skill_base_dir: \"agent/skills\"  # Skill 根目录\n  a2x_registry:\n    base_url: \"http://127.0.0.1:8000\"\n    timeout: 30.0\n    api_key: \"\"\n    # null uses the SDK default ownership store under the process HOME.\n    # Keep ownership persistent so teardown can call replace_agent_card safely.\n    ownership_file:\n    # Allowed values: teammate / teamleader\n    role: \"teammate\"\n    # When role=teammate, automatic blank-agent registration during agent\n    # initialization calls AsyncA2XRegistryClient.register_blank_agent(...).\n    # Both dataset and endpoint must be configured explicitly; if either is\n    # missing, auto-registration is skipped and only a log is recorded.\n    dataset: \"team_pool\"\n    endpoint: \"tcp://127.0.0.1:28610\"\n\ntools:\n  - todo\n  - skill\n\nemail_settings:\n  email_address: ${EMAIL_ADDRESS}\n  token: ${EMAIL_TOKEN}\n  smtp_server: ${SMTP_SERVER:-smtp.gmail.com}\n  port: ${EMAIL_PORT:-587}\n\nembed:\n  embed_api_key: ${EMBED_API_KEY}\n  embed_base_url: ${EMBED_API_BASE}\n  embed_model: ${EMBED_MODEL}\n\ntask_memory:\n  # Set enabled: true to activate TaskMemoryService skill tools\n  # (experience_retrieve, experience_learn, experience_clear)\n  enabled: true\n  # Override defaults below if task memory uses a different model/key than the main agent\n  llm_model: ${TASK_MEMORY_LLM_MODEL}\n  embedding_model: ${TASK_MEMORY_EMBED_MODEL}\n  api_key: ${TASK_MEMORY_API_KEY}\n  api_base: ${TASK_MEMORY_API_BASE}\n  # Retrieval and summary algorithms: ACE | ReasoningBank | ReMe\n  retrieval_algo: ACE\n  summary_algo: ACE\n\ngateway:\n  # SessionMap 仅用于企业claw场景，如 feishu_enterprise 等通道：将平台身份映射为 Agent 的 session_id。\n  # 取值：per_chat_bot（默认，同 chat+bot 共享会话）, per_chat_bot_user（按 user 分会话）\n  session_map_scope: per_chat_bot\n\nheartbeat:\n  # 心跳间隔（秒），默认 60\n  every: 3600\n  # 心跳结果回传的 channel（如 \"web\"），\n  target: web\n  # 心跳生效时间段（本地时间），start <= now < end 时心跳生效\n  active_hours:\n    start: 08:00\n    end: 22:00\n\nchannels:\n  web:\n    send_file_allowed: true\n  feishu:\n    # 飞书应用配置\n    app_id:\n    app_secret:\n    encrypt_key:\n    verification_token:\n    allow_from:\n    enable_streaming: false\n    enabled: false\n    send_file_allowed: true\n    # 群聊数字分身（默认关闭）\n    group_digital_avatar: false\n    my_user_id: \"\"\n    bot_name: \"\"\n    enable_memory: false\n  feishu_enterprise:\n    # 企业飞书多 Bot 配置（每个 bot 会注册为独立 channel: feishu_enterprise:<app_id>）\n    # bot_a:\n    #   app_id:\n    #   app_secret:\n    #   encrypt_key:\n    #   verification_token:\n    #   allow_from: []\n    #   enable_streaming: true\n    #   chat_id:\n    #   enabled: false\n  xiaoyi:\n    # 华为小艺 A2A 配置\n    mode: xiaoyi_channel\n    ak:\n    sk:\n    api_id:\n    push_id:\n    agent_id:\n    ws_url1: wss://hag.cloud.huawei.com/openclaw/v1/ws/link\n    ws_url2: wss://116.63.174.231/openclaw/v1/ws/link\n    enable_streaming: true\n    enabled: false\n    # xiaoyi_claw配置\n    uid:\n    api_key:\n    push_url:\n    file_upload_url:\n    # 小艺手机端插件tools调用，会添加相关tools到系统提示词\n    phone_tools_enabled: false\n    send_file_allowed: true\n  dingtalk:\n    # 钉钉应用配置\n    client_id:\n    client_secret:\n    allow_from: []\n    enabled: false\n    send_file_allowed: true\n  telegram:\n    # Telegram Bot 配置\n    # 从 @BotFather 获取 bot_token\n    bot_token:\n    # 用户白名单（Telegram user_id），为空则允许所有用户\n    allow_from: []\n    # 消息解析模式: Markdown, HTML, None\n    parse_mode: Markdown\n    # 群聊模式: mention(仅响应@提及), reply(仅响应回复), all(响应所有), off(禁用群聊)\n    group_chat_mode: mention\n    enabled: false\n  discord:\n    # Discord Bot 配置（当前版本仅支持参数管理）\n    # 可与用户私聊（DM）：仍受 allow_from 约束\n    # Bot Token（Discord Developer Portal -> Bot）\n    bot_token:\n    # Application ID（Discord Developer Portal -> General Information）\n    application_id:\n    # 目标服务器 ID（Guild ID）\n    guild_id:\n    # 目标频道 ID（Channel ID）\n    channel_id:\n    # 用户白名单（Discord user_id），为空则允许所有用户\n    allow_from: []\n    # 是否关闭私信功能\n    block_dm: false\n    enabled: false\n  whatsapp:\n    # WhatsApp 配置（通过本地 Baileys bridge）\n    bridge_ws_url: ws://127.0.0.1:19600/ws\n    default_jid:\n    allow_from: []\n    enable_streaming: true\n    auto_start_bridge: false\n    bridge_command: node scripts/whatsapp-bridge.js\n    bridge_workdir:\n    enabled: false\n  wechat:\n    # 个人微信 iLink Bot API 配置\n    enable_streaming: false\n    base_url: https://ilinkai.weixin.qq.com\n    bot_token:\n    ilink_bot_id:\n    ilink_user_id:\n    allow_from: []\n    auto_login: true\n    qrcode_poll_interval_sec: 2.0\n    long_poll_timeout_sec: 45\n    backoff_base_sec: 1.0\n    backoff_max_sec: 30.0\n    credential_file: ~/.wx-ai-bridge/credentials.json\n    enabled: false\n  wecom:\n    # 企业微信 AI 机器人配置\n    bot_id:\n    secret:\n    ws_url: wss://openws.work.weixin.qq.com\n    allow_from: []\n    enable_streaming: true\n    send_thinking_message: false\n    enabled: false\n    send_file_allowed: true\n    # 群聊数字分身（默认关闭）\n    group_digital_avatar: false\n    my_user_id: \"\"\n    bot_name: \"\"\n    enable_memory: false\n\n# ========== 细粒度权限管控（tiered_policy）==========\n#\n# schema: tiered_policy（或兼容 v_cc / v4.2）时由 tiered_policy.evaluate_tiered_policy 求值；\n# permission_mode: normal|strict 决定 severity 映射，见 agentserver/permissions/tiered_policy.py。\n# severity（normal）：LOW/MEDIUM→allow，HIGH/CRITICAL→ask；strict 下 MEDIUM→ask、CRITICAL→deny。\n# rules[*].action: 可选显式动作 allow|ask|deny；配置后优先于 severity 映射，适合敏感文件读取、\n# 系统控制等不希望随 permission_mode 漂移的规则。\n# 内置参数规则 > 用户 rules；整工具存在则不用 defaults；详见 tiered_policy 模块说明。\n#\n# 三种动作: allow / ask / deny\npermissions:\n  enabled: false\n  schema: tiered_policy\n  permission_mode: normal\n\n  defaults:\n    \"*\": \"allow\"\n\n  tools:\n    bash: ask\n    mcp_exec_command: ask\n    create_terminal: ask\n    write: ask\n    write_file: ask\n    edit_file: ask\n    search_replace: ask\n    write_memory: allow\n    edit_memory: allow\n    read_memory: allow\n    memory_search: allow\n    memory_get: allow\n    todo_create: allow\n    todo_insert: allow\n    todo_complete: allow\n    todo_remove: allow\n    todo_list: allow\n    # Coding Memory 工具权限\n    coding_memory_write: allow\n    coding_memory_edit: allow\n    coding_memory_read: allow\n    # 外接记忆工具（External Memory — OpenJiuwen / Mem0 / OpenViking）\n    ltm_search: allow\n    ltm_search_summary: allow\n    mem0_profile: allow\n    mem0_search: allow\n    mem0_conclude: allow\n    viking_search: allow\n    viking_read: allow\n    viking_browse: allow\n    viking_remember: allow\n    viking_add_resource: allow\n    mcp_free_search: allow\n    mcp_paid_search: allow\n    mcp_fetch_webpage: allow\n    cron_list_jobs: allow\n    cron_get_job: allow\n    cron_create_job: allow\n    cron_update_job: allow\n    cron_delete_job: allow\n    cron_toggle_job: allow\n    cron_preview_job: allow\n\n  rules:\n    - id: shell_allow_dir\n      tools: [bash, mcp_exec_command, create_terminal]\n      pattern: \"dir *\"\n      severity: LOW\n    - id: shell_allow_ls\n      tools: [bash, mcp_exec_command, create_terminal]\n      pattern: \"ls *\"\n      severity: LOW\n    - id: shell_allow_pwd\n      tools: [bash, mcp_exec_command, create_terminal]\n      pattern: \"pwd *\"\n      severity: LOW\n    - id: shell_allow_cd\n      tools: [bash, mcp_exec_command, create_terminal]\n      pattern: \"cd *\"\n      severity: LOW\n    - id: shell_allow_echo\n      tools: [bash, mcp_exec_command, create_terminal]\n      pattern: \"echo *\"\n      severity: LOW\n    - id: shell_allow_cat\n      tools: [bash, mcp_exec_command, create_terminal]\n      pattern: \"cat *\"\n      severity: LOW\n    - id: shell_allow_type\n      tools: [bash, mcp_exec_command, create_terminal]\n      pattern: \"type *\"\n      severity: LOW\n    - id: shell_allow_head\n      tools: [bash, mcp_exec_command, create_terminal]\n      pattern: \"head *\"\n      severity: LOW\n    - id: shell_allow_tail\n      tools: [bash, mcp_exec_command, create_terminal]\n      pattern: \"tail *\"\n      severity: LOW\n    - id: shell_allow_git_status\n      tools: [bash, mcp_exec_command, create_terminal]\n      pattern: \"git status *\"\n      severity: LOW\n    - id: shell_allow_git_log\n      tools: [bash, mcp_exec_command, create_terminal]\n      pattern: \"git log *\"\n      severity: LOW\n    - id: shell_allow_git_diff\n      tools: [bash, mcp_exec_command, create_terminal]\n      pattern: \"git diff *\"\n      severity: LOW\n    - id: shell_allow_git_branch\n      tools: [bash, mcp_exec_command, create_terminal]\n      pattern: \"git branch *\"\n      severity: LOW\n    - id: shell_ask_rm\n      tools: [bash, mcp_exec_command, create_terminal]\n      pattern: \"rm *\"\n      severity: HIGH\n    - id: shell_ask_del\n      tools: [bash, mcp_exec_command, create_terminal]\n      pattern: \"del *\"\n      severity: HIGH\n    - id: shell_ask_rd\n      tools: [bash, mcp_exec_command, create_terminal]\n      pattern: \"rd *\"\n      severity: HIGH\n    - id: shell_ask_mv\n      tools: [bash, mcp_exec_command, create_terminal]\n      pattern: \"mv *\"\n      severity: HIGH\n    - id: shell_ask_cp\n      tools: [bash, mcp_exec_command, create_terminal]\n      pattern: \"cp *\"\n      severity: HIGH\n    - id: shell_ask_chmod\n      tools: [bash, mcp_exec_command, create_terminal]\n      pattern: \"chmod *\"\n      severity: HIGH\n    - id: shell_ask_chown\n      tools: [bash, mcp_exec_command, create_terminal]\n      pattern: \"chown *\"\n      severity: HIGH\n    - id: shell_ask_sensitive_file_reads\n      tools: [bash, mcp_exec_command, create_terminal]\n      pattern: 're:(?i)(^|[\\s;&|()])((cat|type|less|more|head|tail|grep|find|Get-Content|Select-String)\\b[^;&|]*(id_rsa|id_ed25519|\\.pem\\b|\\.pfx\\b|\\.key\\b|\\.kube/config|\\.aws/(credentials|config)|\\.npmrc\\b|\\.env(\\.[A-Za-z0-9_-]+)?\\b|authorized_keys|\\.ssh/))'\n      severity: HIGH\n    - id: path_ask_ssh\n      tools: [read_file, write_file, edit_file, read_text_file, write_text_file, write, read, glob_file_search, glob, list_dir, list_files, grep, search_replace]\n      pattern: \"**/.ssh/**\"\n      severity: HIGH\n    - id: path_ask_env\n      tools: [read_file, write_file, edit_file, read_text_file, write_text_file, write, read, glob_file_search, glob, list_dir, list_files, grep, search_replace]\n      pattern: \"**/.env*\"\n      severity: HIGH\n\n  # 数字分身 owner-scoped 权限（默认空，不生效）\n  owner_scopes: {}\n  deny_guidance_message: \"\"\n\n  # 外部目录访问 (访问 workspace 外路径时的权限)\n  external_directory:\n    \"*\": \"ask\"\n\nbrowser:\n  # chrome_path can be a string or per-OS map.\n  # Example:\n  # chrome_path:\n  #   windows: \"C:\\\\Users\\\\YOUR_USER\\\\AppData\\\\Local\\\\Google\\\\Chrome\\\\Application\\\\chrome.exe\"\n  #   macos: \"/Applications/Google Chrome.app\"\n  #   linux: \"/usr/bin/google-chrome\"\n  remote_debugging_address: \"127.0.0.1\"\n  remote_debugging_port: 9222\n  # empty means use launcher default profile path by OS\n  user_data_dir: \"\"\n  profile_directory: \"Default\"\n\nupdater:\n  enabled: true\n  repo_owner: openJiuwen\n  repo_name: jiuwenswarm\n  release_api_url: \"\"\n  asset_name_pattern: \"JiuwenSwarm-setup-{version}.exe\"\n  sha256_name_pattern: \"JiuwenSwarm-setup-{version}.exe.sha256\"\n  timeout_seconds: 20\n\nextensions:\n  # 扩展包搜索目录（字符串），用 ';' 分割多个目录：\n  # EXTENSION_DIRS=\"E:/a;D:/b\"\n  extension_dirs: ${EXTENSION_DIRS:-}\n\n\nteam:\n  # Distributed teammate template. Copy this file to\n  # <TEAMMATE_HOME>/.jiuwenswarm/config/config.yaml and adjust registry/storage/ports.\n  runtime:\n    mode: distributed\n    role: teammate\n    member_name: teammate_1\n\n  team_name: jiuwen_team\n  lifecycle: persistent\n  teammate_mode: build_mode\n  spawn_mode: inprocess\n\n  leader:\n    member_name: team_leader\n    display_name: 团队领导\n    persona: \"天才项目管理专家，擅长任务分解和团队协调\"\n\n  agents:\n    leader:\n      workspace:\n        stable_base: true\n      max_iterations: 200\n      completion_timeout: 600.0\n    teammate:\n      workspace:\n        stable_base: true\n      max_iterations: 200\n      completion_timeout: 600.0\n\n  workspace:\n    enabled: true\n    root_path: ${JIUWEN_TEAM_WORKSPACE_ROOT:-/tmp/jiuwenswarm/shared_workspace/jiuwen_team}\n    version_control: false\n\n  transport:\n    type: pyzmq\n    params:\n      request_timeout: 20\n      direct_addr: tcp://0.0.0.0:28611\n      bootstrap_direct_addr: tcp://127.0.0.1:28610\n      pubsub_publish_addr: tcp://127.0.0.1:28556\n      pubsub_subscribe_addr: tcp://127.0.0.1:28557\n\n  storage:\n    #type: postgresql\n    type: sqlite\n    params:\n      #connection_string: postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/jiuwen_team\n      connection_string: \"/home/cz776/team_shared.db\"\n\nmcp:\n  servers: []\n  # 示例：\n  # servers:\n  #   - name: playwright\n  #     enabled: true\n  #     transport: stdio\n  #     command: python\n  #     args: [\"path/to/server.py\", \"--transport\", \"stdio\"]\n  #     cwd: .\n  #     env:\n  #       LOG_LEVEL: INFO\n  #   - name: local-sse\n  #     enabled: false\n  #     transport: sse\n  #     url: http://127.0.0.1:9000/sse\n  #     headers:\n  #       Authorization: Bearer ${MCP_TOKEN}\n  #     timeout_s: 30\n\nmodes:\n  # 一级模式 agent / code / team\n  agent:\n    # agent 模式支持 性能/规划/集群\n    fast:\n      memory:\n        enabled: true\n        is_proactive: false\n      rails:\n      tools:\n    plan:\n      memory:\n        enabled: true\n        is_proactive: true\n      rails:\n      tools:\n  code:\n    # 动态 Rails — 列表中出现的 = 启用；不出现的 = 不启用\n    # 固定 Rails（以下 Rails 已在代码中固定挂载，无需在此配置）：\n    #   RuntimePromptRail, ResponsePromptRail, JiuSwarmStreamEventRail, SecurityRail,\n    #   PermissionInterruptRail, SysOperationRail(FileSystemRail), LspRail,\n    #   ProjectMemoryRail, CodingMemoryRail, AgentModeRail, StructuredAskUserRail,\n    #   ConfirmInterruptRail, ContextProcessorRail\n    rails:\n      - FileSystemRail\n      - SkillUseRail\n\n    # 动态 Tools — 列表中出现的 = 启用\n    # send_file_to_user 由运行时 _update_session_tools 注册，不在此配置\n    # coding_memory_read/write/edit 由 CodingMemoryRail 在 subagent 内部注册，不在此配置\n    tools:\n      - web_free_search\n      - web_fetch_webpage\n      - web_paid_search\n      - user_todos\n\n    embedding_config:\n      model_name:\n      base_url:\n      api_key:\n  team:\n    jiuwen_team:\n      team_name: jiuwen_team\n      lifecycle: persistent\n      teammate_mode: build_mode\n      spawn_mode: inprocess\n\n      leader:\n        member_name: team_leader\n        display_name: 团队领导\n        persona: \"天才项目管理专家，擅长任务分解和团队协调\"\n\n      agents:\n        leader:\n          workspace:\n            stable_base: true\n          max_iterations: 200\n          completion_timeout: 600.0\n        teammate:\n          workspace:\n            stable_base: true\n          max_iterations: 200\n          completion_timeout: 600.0\n\n      workspace:\n        enabled: true\n        root_path: ${JIUWEN_TEAM_WORKSPACE_ROOT:-/tmp/jiuwenswarm/shared_workspace/jiuwen_team}\n        version_control: false\n\n      transport:\n        type: pyzmq\n        params:\n          request_timeout: 20\n          direct_addr: tcp://0.0.0.0:28611\n          bootstrap_direct_addr: tcp://127.0.0.1:28610\n          pubsub_publish_addr: tcp://127.0.0.1:28556\n          pubsub_sub