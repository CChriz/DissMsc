{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ir2.retrieval/answer.schema.json",
  "title": "IR2 Answer Schema",
  "description": "Evidence package for IR2 offline retrieval: Initiative Peregrine operational codename.",
  "type": "object",
  "required": ["question", "answer", "evidence"],
  "properties": {
    "question": {
      "type": "string",
      "minLength": 1,
      "description": "The retrieval question."
    },
    "answer": {
      "type": "string",
      "minLength": 1,
      "description": "The discovered answer (operational codename)."
    },
    "evidence": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "description": "Evidence from two distinct source documents.",
      "items": {
        "type": "object",
        "required": ["doc", "lines"],
        "properties": {
          "doc": {
            "type": "string",
            "minLength": 1,
            "pattern": "^doc_[AB]\\.txt$",
            "description": "Source document filename. Must be doc_A.txt or doc_B.txt (doc_trap.txt is forbidden)."
          },
          "lines": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "description": "Line range [start, end] in the source document, inclusive.",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "description": "Verbatim excerpt from the source document."
          }
        }
      }
    }
  }
}
